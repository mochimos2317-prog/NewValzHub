local function triGrad(i, r)
    local g = Instance.new("UIGradient", i)
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0,229,255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,71,171)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(156,39,176)),
    })
    g.Rotation = r or 45
    return g
end

