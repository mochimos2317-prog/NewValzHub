-- Config Manager
local CONFIG_FOLDER = "ValzHub/Configs"
pcall(function() if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end end)

local function getConfigList()
    local list = {}
    pcall(function()
        if listfiles then
            for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
                local name = f:match("([^/\\]+)%.json$")
                if name then table.insert(list, name) end
            end
        end
    end)
    table.sort(list)
    return list
end

local function saveConfig(name)
    if not name or name == "" then
        lib:Notify({ Title = "Error", Description = "Enter config name", Duration = 2 })
        return
    end
    local data = {}
    for flag, reg in pairs(flagRegistry) do
        if reg.getV then
            local ok, val = pcall(reg.getV)
            if ok then data[flag] = val end
        end
    end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    pcall(function() writefile(path, game:GetService("HttpService"):JSONEncode(data)) end)
    lib:Notify({ Title = "Config", Description = "Saved: " .. name, Duration = 2 })
end

local function loadConfig(name)
    if not name or name == "" then
        lib:Notify({ Title = "Error", Description = "Enter config name", Duration = 2 })
        return
    end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    local ok, content = pcall(function() return readfile(path) end)
    if not ok or not content then
        lib:Notify({ Title = "Error", Description = "Config not found", Duration = 2 })
        return
    end
    local data = game:GetService("HttpService"):JSONDecode(content)
    for flag, val in pairs(data) do
        local reg = flagRegistry[flag]
        if reg and reg.setV then pcall(reg.setV, val) end
    end
    lib:Notify({ Title = "Config", Description = "Loaded: " .. name, Duration = 2 })
end

local function deleteConfig(name)
    if not name or name == "" then return end
    pcall(function() delfile(CONFIG_FOLDER .. "/" .. name .. ".json") end)
    lib:Notify({ Title = "Config", Description = "Deleted: " .. name, Duration = 2 })
end

