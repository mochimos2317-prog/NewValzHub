local function bindFloat(btn, stateGetter, stateSetter, stroke, accent)
    local pressed = false
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            pressed = true
        end
    end)
    btn.InputEnded:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and pressed then
            pressed = false
            local ns = not stateGetter()
            stateSetter(ns)
            v:SetFloatButtonVisual(btn, stroke, ns, accent)
        end
    end)
end

