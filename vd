            return o
        end
        function o:AddKeyPicker(n, op)
            if not op or not op.Callback then return o end
            local ks = op.Default or n
            if not ks or ks == "None" then return o end
            local kc = Enum.KeyCode[ks]
            if not kc then return o end
            local m = op.Mode or "Toggle"
            local s = false
            UIS.InputBegan:Connect(function(i, gp)
                if gp or i.KeyCode ~= kc then return end
                if m == "Toggle" then
                    s = not s
                    pcall(op.Callback, s)
                else
                    s = true
                    pcall(op.Callback, true)
                end
            end)
            return o
        end
        if flag then flagRegistry[flag] = { setV = setV } end
        return o
    end

