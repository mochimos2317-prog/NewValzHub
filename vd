local tbl = { Generators = {}, Hooks = {}, Gates = {}, Pallets = {}, Windows = {} }
local tbl4 = { Generators = {}, Hooks = {}, Gates = {}, Pallets = {}, Windows = {}, SCPs = {} }

local lastScan = 0
local function scanMap(force)
    if not force and tick() - lastScan < 3 then return end
    lastScan = tick()
    for _, k in ipairs({"Generators","Windows","Pallets","Hooks","Gates"}) do table.clear(tbl[k]) end
    for _, k in ipairs({"Generators","Windows","Pallets","Hooks","Gates","SCPs"}) do table.clear(tbl4[k]) end
    local map = workspace:FindFirstChild("Map") or workspace
    for i, d in ipairs(map:GetDescendants()) do
        if i % 200 == 0 then task.wait() end
        if d:IsA("Model") then
            local n = string.lower(d.Name)
            if n == "generator" then
                local bp = d:FindFirstChildWhichIsA("BasePart")
                if bp then local t = { model = d, part = bp }; table.insert(tbl.Generators, t); table.insert(tbl4.Generators, t) end
            elseif n == "hook" and d:FindFirstChild("HookPoint") then table.insert(tbl.Hooks, d); table.insert(tbl4.Hooks, d)
            elseif n == "gate" and d:FindFirstChild("ExitLever") then table.insert(tbl.Gates, d); table.insert(tbl4.Gates, d)
            elseif n == "window" then table.insert(tbl.Windows, d); table.insert(tbl4.Windows, d) end
        elseif d:IsA("BasePart") and d.Name == "PrimaryPartPallet" then
            local p = d.Parent
            if p and not table.find(tbl.Pallets, p) then table.insert(tbl.Pallets, p); table.insert(tbl4.Pallets, p) end
        end
    end
end

local function tpTo(obj)
    if not obj then return end
    local c = lp.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local off = Vector3.new(0,3,0)
    if obj:IsA("BasePart") then hrp.CFrame = obj.CFrame + off
    elseif obj:IsA("Model") then
        local bp = obj:FindFirstChildWhichIsA("BasePart")
        if bp then hrp.CFrame = bp.CFrame + off end
    end
    lib:Notify({ Title = "Teleport", Description = "OK", Duration = 1 })
end

local function createESP(parent, name, cfg)
    if not parent then return end
    local bb = parent:FindFirstChild(name)
    local pieces = {}
    if cfg.name and cfg.name ~= "" then table.insert(pieces, cfg.name) end
    if cfg.distance then table.insert(pieces, "[" .. cfg.distance .. "s]") end
    local text = table.concat(pieces, " | ")
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = name
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0,220,0,22)
        bb.StudsOffset = Vector3.new(0,3.2,0)
        bb.Parent = parent
        local lbl = Instance.new("TextLabel", bb)
        lbl.Name = "Text"
        lbl.Size = UDim2.new(1,0,1,0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 12
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0,0,0)
    end
    local t = bb:FindFirstChild("Text")
    if t then t.Text = text; t.TextColor3 = cfg.color or Color3.new(1,1,1) end
end

local function clearESP(kind)
    if kind == "Player" or kind == "Killer" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                for _, n in ipairs({"PEH","PE_Text","KEH","KE_Text"}) do
                    local x = p.Character:FindFirstChild(n)
                    if x then x:Destroy() end
                end
            end
        end
    elseif kind == "Generator" then
        for _, g in pairs(tbl4.Generators) do
            if g.model and g.model.Parent then
                for _, n in ipairs({"GEH","GE_Text"}) do
                    local x = g.model:FindFirstChild(n)
                    if x then x:Destroy() end
                end
            end
        end
    elseif kind == "Pallet" then
        for _, p in pairs(tbl4.Pallets) do if p and p.Parent then local x = p:FindFirstChild("PalletEH"); if x then x:Destroy() end end end
    elseif kind == "Hook" then
        for _, h in pairs(tbl4.Hooks) do if h and h.Parent then local x = h:FindFirstChild("HookEH"); if x then x:Destroy() end end end
    elseif kind == "Gate" then
        for _, g in pairs(tbl4.Gates) do if g and g.Parent then local x = g:FindFirstChild("GateEH"); if x then x:Destroy() end end end
    end
end

local function clearAllESP()
    for _, k in ipairs({"Player","Killer","Generator","Pallet","Hook","Gate"}) do clearESP(k) end
end

local function updatePlayerESP()
    if not _G.Ox.ESPConfig.Master then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local char = p.Character
            local isK = p.Team and p.Team.Name == "Killer"
            for _, n in ipairs(isK and {"PEH","PE_Text"} or {"KEH","KE_Text"}) do
                local x = char:FindFirstChild(n)
                if x then x:Destroy() end
            end
            local enabled = isK and _G.Ox.ESPConfig.Killer or (not isK and _G.Ox.ESPConfig.Player)
            local hlName = isK and "KEH" or "PEH"
            local txtName = isK and "KE_Text" or "PE_Text"
            local color = isK and _G.Ox.ESPColors.Killer or _G.Ox.ESPColors.Player
            if enabled then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local dist = hrp and math.floor((hrp.Position - lp.Character.HumanoidRootPart.Position).Magnitude) or nil
                local hl = char:FindFirstChild(hlName) or Instance.new("Highlight", char)
                hl.Name = hlName
                hl.FillColor = color
                hl.OutlineColor = color
                hl.FillTransparency = _G.Ox.ESPConfig.Outline and 1 or 0.5
                hl.OutlineTransparency = 0
                local nm = _G.Ox.ESPConfig.Name and p.Name or nil
                if not nm and not _G.Ox.ESPConfig.Distance then
                    local t = char:FindFirstChild(txtName)
                    if t then t:Destroy() end
                else
                    createESP(char, txtName, { name = nm or "", distance = _G.Ox.ESPConfig.Distance and dist or nil, color = color })
                end
            else
                for _, n in ipairs({hlName, txtName}) do
                    local x = char:FindFirstChild(n)
                    if x then x:Destroy() end
                end
            end
        end
    end
end

local function updateStaticESP()
    if not _G.Ox.ESPConfig.Master then return end
    if _G.Ox.ESPConfig.Generator then
        for _, g in pairs(tbl4.Generators) do
            local m = g.model
            if m and m.Parent then
                local prog = math.floor(m:GetAttribute("RepairProgress") or 0)
                local col = prog >= 100 and _G.Ox.ESPColors.GeneratorDone or _G.Ox.ESPColors.Generator
                local hl = m:FindFirstChild("GEH") or Instance.new("Highlight", m)
                hl.Name = "GEH"
                hl.FillColor = col
                hl.OutlineColor = col
                hl.FillTransparency = _G.Ox.ESPConfig.Outline and 1 or 0.5
                hl.OutlineTransparency = 0
                createESP(m, "GE_Text", { name = "GEN", distance = prog, color = col })
            end
        end
    end
    if _G.Ox.ESPConfig.Pallet then
        for _, p in pairs(tbl4.Pallets) do
            if p and p.Parent then
                local hl = p:FindFirstChild("PalletEH") or Instance.new("Highlight", p)
                hl.Name = "PalletEH"
                hl.FillColor = _G.Ox.ESPColors.Pallet
                hl.OutlineColor = _G.Ox.ESPColors.Pallet
                hl.FillTransparency = _G.Ox.ESPConfig.Outline and 1 or 0.5
            end
        end
    end
end

